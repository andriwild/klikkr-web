---
/**
 * One sport page (/padel/, /en/table-tennis/, …): what Klikkr does for the
 * sport, the official rules and hobby variants, and an FAQ. Static HTML, no
 * client JavaScript; clicks are tracked with Umami data attributes.
 */
import Layout from '../../layouts/Layout.astro';
import { Footer } from '../Footer.tsx';
import {
  getTranslations,
  getLocalizedPath,
  SITE_URL,
  type Locale,
} from '../../i18n';
import {
  getSports,
  sportOrder,
  sportPath,
  sportAlternatePaths,
  type SportId,
} from '../../data/sports';

interface Props {
  id: SportId;
  lang: Locale;
}

const { id, lang } = Astro.props;
const { ui, sports } = getSports(lang);
const s = sports[id];
const tApp = getTranslations(lang).appFeatures;
const homePath = getLocalizedPath('/', lang);
const pageUrl = `${SITE_URL}${sportPath(id, lang)}`;

const APP_STORE_URL = 'https://apps.apple.com/ch/app/klikkr/id6761069158';
const GOOGLE_PLAY_URL =
  'https://play.google.com/store/apps/details?id=ch.wild.klikkr';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: ui.breadcrumbHome,
      item: `${SITE_URL}${homePath}`,
    },
    { '@type': 'ListItem', position: 2, name: s.name, item: pageUrl },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const otherSports = sportOrder.filter((other) => other !== id);
---

<Layout
  title={s.seoTitle}
  description={s.seoDescription}
  lang={lang}
  currentPage="sport"
  alternatePaths={sportAlternatePaths(id)}
>
  <Fragment slot="head-extra">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <article class="w-full">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-zinc-900">
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-500/10 via-zinc-950 to-zinc-950 pointer-events-none"></div>
      <div class="relative container mx-auto max-w-5xl px-4 md:px-6 pt-8 pb-14 md:pt-12 md:pb-20">
        <nav aria-label="Breadcrumb" class="text-sm text-zinc-500 mb-8">
          <a href={homePath} class="hover:text-emerald-400 transition-colors">{ui.breadcrumbHome}</a>
          <span class="mx-2" aria-hidden="true">›</span>
          <span class="text-zinc-300">{s.name}</span>
        </nav>
        <div class="grid md:grid-cols-[1fr_auto] gap-10 items-center">
          <div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-50 leading-tight">
              {s.h1}
            </h1>
            <p class="mt-5 text-lg text-zinc-300 leading-relaxed max-w-2xl">{s.lead}</p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href={`${homePath}#checkout`}
                data-umami-event="sport-cta-order"
                data-umami-event-sport={id}
                class="inline-flex items-center justify-center rounded-full bg-emerald-500 hover:bg-emerald-600 text-zinc-950 font-bold h-12 px-6 transition-transform hover:scale-105"
              >
                {ui.ctaOrder}
              </a>
              <a
                href={APP_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="sport-store-ios"
                data-umami-event-sport={id}
                aria-label={tApp.downloadAppStore}
                class="transition-transform hover:scale-[1.03]"
              >
                <img src="/badges/app-store-badge.svg" alt={tApp.downloadAppStore} class="h-12 w-auto" width="160" height="48" />
              </a>
              <a
                href={GOOGLE_PLAY_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="sport-store-android"
                data-umami-event-sport={id}
                aria-label={tApp.downloadGooglePlay}
                class="transition-transform hover:scale-[1.03]"
              >
                <img src="/badges/google-play-badge.png" alt={tApp.downloadGooglePlay} class="h-[72px] w-auto -my-3" width="186" height="72" />
              </a>
            </div>
            <p class="mt-3 text-sm text-zinc-500">{ui.appFree}</p>
          </div>
          <img
            src="/wristband_click.png"
            alt=""
            width="480"
            height="480"
            class="hidden md:block w-64 lg:w-72 h-auto rounded-3xl border border-zinc-800"
          />
        </div>
      </div>
    </section>

    <!-- What Klikkr does for this sport -->
    <section class="container mx-auto max-w-5xl px-4 md:px-6 py-14 md:py-20">
      <h2 class="text-3xl font-bold text-zinc-50">{s.klikkrTitle}</h2>
      <p class="mt-4 text-zinc-300 leading-relaxed max-w-3xl">{s.klikkrIntro}</p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {s.klikkrPoints.map((p) => (
          <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
            <h3 class="text-lg font-bold text-zinc-100">{p.title}</h3>
            <p class="mt-2 text-zinc-400 leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
      <img
        src={`/app/${lang}/rules.webp`}
        alt={ui.rulesScreenshotAlt}
        width="2400"
        height="1360"
        loading="lazy"
        class="mt-10 mx-auto w-full max-w-3xl h-auto rounded-3xl bg-white"
      />
    </section>

    <!-- Official rules -->
    <section class="border-t border-zinc-900 bg-zinc-900/20">
      <div class="container mx-auto max-w-3xl px-4 md:px-6 py-14 md:py-20">
        <h2 class="text-3xl font-bold text-zinc-50">{s.rulesTitle}</h2>
        <p class="mt-4 text-zinc-300 leading-relaxed">{s.rulesIntro}</p>
        {s.rules.map((r) => (
          <div class="mt-10">
            <h3 class="text-xl font-bold text-emerald-400">{r.title}</h3>
            {r.paragraphs?.map((p) => (
              <p class="mt-3 text-zinc-300 leading-relaxed">{p}</p>
            ))}
            {r.bullets && (
              <ul class="mt-3 space-y-2 list-disc pl-5 text-zinc-300 leading-relaxed marker:text-emerald-500">
                {r.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ))}
        <p class="mt-10 text-sm text-zinc-500">
          {ui.sourceLabel}{' '}
          <a href={s.source.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-emerald-400">{s.source.label}</a>.
          {' '}{ui.rulesAsOf}
        </p>
      </div>
    </section>

    <!-- Hobby variants -->
    <section class="container mx-auto max-w-5xl px-4 md:px-6 py-14 md:py-20">
      <h2 class="text-3xl font-bold text-zinc-50">{s.variantsTitle}</h2>
      <p class="mt-4 text-zinc-300 leading-relaxed max-w-3xl">{s.variantsIntro}</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {s.variants.map((v) => (
          <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
            <h3 class="text-lg font-bold text-zinc-100">{v.title}</h3>
            <p class="mt-2 text-zinc-400 leading-relaxed">{v.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-zinc-900 bg-zinc-900/20">
      <div class="container mx-auto max-w-3xl px-4 md:px-6 py-14 md:py-20">
        <h2 class="text-3xl font-bold text-zinc-50">{ui.faqTitle}</h2>
        <div class="mt-8 space-y-3">
          {s.faq.map((f) => (
            <details class="group rounded-2xl border border-zinc-800 bg-zinc-900/40 open:border-emerald-500/30">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left font-bold text-zinc-100 [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-zinc-500 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <p class="px-5 pb-5 text-zinc-400 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Other sports and call to action -->
    <section class="container mx-auto max-w-5xl px-4 md:px-6 py-14 md:py-20">
      <h2 class="text-2xl font-bold text-zinc-50">{ui.otherSportsTitle}</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {otherSports.map((other) => (
          <a
            href={sportPath(other, lang)}
            class="rounded-full border border-zinc-800 bg-zinc-900/60 px-5 py-2 font-semibold text-zinc-300 hover:border-emerald-500/40 hover:text-emerald-400 transition-colors"
          >
            {sports[other].name}
          </a>
        ))}
      </div>

      <div class="mt-14 rounded-3xl border border-emerald-500/20 bg-emerald-500/5 p-8 md:p-10 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-50">{ui.ctaBandTitle}</h2>
        <p class="mt-3 text-zinc-300 max-w-2xl mx-auto">{ui.ctaBandText}</p>
        <a
          href={`${homePath}#checkout`}
          data-umami-event="sport-cta-order-bottom"
          data-umami-event-sport={id}
          class="mt-6 inline-flex items-center justify-center rounded-full bg-emerald-500 hover:bg-emerald-600 text-zinc-950 font-bold h-12 px-6 transition-transform hover:scale-105"
        >
          {ui.ctaOrder}
        </a>
      </div>
    </section>
  </article>

  <Footer client:visible slot="footer" lang={lang} />
</Layout>
